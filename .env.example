# Copy to .env (never commit .env). One file is shared by client and server.

# --- Server ---
PORT=4000
# Supabase > Project Settings > Database > Connection string (use the "Session pooler" URI)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres
# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://xxxx.supabase.co
# Optional. Only needed for legacy projects that sign JWTs with a shared secret (HS256).
# Leave blank for new projects: the server verifies tokens via the project's public JWKS.
SUPABASE_JWT_SECRET=
# Comma-separated list of allowed browser origins (your Vercel URL in production)
CLIENT_ORIGIN=http://localhost:5173

# --- Client (Vite exposes VITE_* vars to the browser; never put secrets here) ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
# Supabase > Project Settings > API > anon / publishable key
VITE_SUPABASE_ANON_KEY=
# Leave blank in dev (Vite proxies /api to the server). In production: your Render URL.
VITE_API_URL=
