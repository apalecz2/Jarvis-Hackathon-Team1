{
  "name": "hackathon-template",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server",
    "db:migrate": "npm run migrate -w server"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
